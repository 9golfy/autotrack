generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Message {
  id         String   @id @default(cuid())
  messageId  String
  userId     String?
  groupId    String?
  displayName String?
  email      String?
  statusMessage String?
  pictureUrl String?
  contentUrl String?
  contentMimeType String?
  source     String   @default("unknown")
  text       String?
  type       String
  rawPayload Json
  context    String?
  contexts   String[] @default([])
  parsed     Json?
  flexTemplate String?
  confidence Decimal?
  importBatchId String?
  timestamp  BigInt
  createdAt  DateTime @default(now())

  @@unique([messageId])
  @@index([context])
  @@index([importBatchId])
  @@index([groupId, timestamp(sort: Desc)])
  @@index([timestamp(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

/// เก็บ role ของ LINE user แต่ละคนในแต่ละกลุ่ม
model GroupMemberRole {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  role        String   // "Admin" | "ญาติ" | "ผู้ดูแล"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([groupId, userId])
  @@index([groupId])
}
